# Local development template. Copy to .env for `pave dev`. Production uses a
# separate, hand-written .env.production (see docs/getting-started.md) which
# must set DEBUG=false, a real SECRET_KEY, and a real ALLOWED_HOSTS.

# --- Required ---

# PostgreSQL connection (postgresql://user:pass@host/dbname)
DATABASE_URL=postgresql://localhost/pave_dev

# Sign session cookies and tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-in-production

# Soniq job queue database. In production point this at the same DB or a dedicated one.
SONIQ_DATABASE_URL=postgresql://localhost/pave_dev

# Comma-separated hostnames allowed in production (e.g. usepave.dev,www.usepave.dev)
ALLOWED_HOSTS=*

# --- Optional ---

# Canonical public origin (e.g. https://usepave.dev). Set this in production:
# email verification and reset links are built from it, not the request Host,
# so a spoofed Host header cannot redirect them. Unset = use the request origin.
BASE_URL=

# Use a local SQLite file instead of PostgreSQL for development
USE_SQLITE=false

# Google OAuth - from https://console.cloud.google.com (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth - from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generic transactional email provider (HTTP). Unset = email logged to console as JSON.
EMAIL_API_KEY=
EMAIL_API_URL=
EMAIL_FROM=Pave <noreply@usepave.dev>

# Error tracking (unset = disabled)
SENTRY_DSN=

# Prometheus metrics endpoint (default off)
ENABLE_METRICS=false

# Avatar uploads. Defaults write into the served static tree for the
# dev story. In production point AVATAR_DIR at a volume mounted outside
# the release directory so a deploy does not erase uploads.
AVATAR_DIR=static/uploads/avatars
AVATAR_MAX_BYTES=4194304

# Shared secret for inbound webhook HMAC signatures. Set in production:
# POST /webhooks/{slug} then requires a matching X-Webhook-Signature. Unset =
# ingestion is open in dev only; production rejects it until this is set.
WEBHOOK_SECRET=

# Best-effort POST of deploy.success events (unset = skipped)
WEBHOOQ_ENDPOINT=

# DEBUG enables /api/docs, console log rendering, and disables Secure cookies
# and CSRF. Correct for local dev; production must set DEBUG=false.
DEBUG=true
LOG_LEVEL=DEBUG
