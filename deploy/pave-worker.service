# systemd unit for the Soniq background worker. Copy to
# /etc/systemd/system/pave-worker.service, then
# `sudo systemctl enable --now pave-worker`. fab deploy restarts this
# alongside pave-api after the symlink flip.

[Unit]
Description=Pave Soniq worker
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/pave/current
# Shared, release-independent env file (see pave-api.service for why).
EnvironmentFile=/srv/pave/shared/.env.production

# The venv is shared across releases and does not install the app package, so
# the worker runs through `python -m app.cli` (resolved against the release on
# sys.path via WorkingDirectory) rather than a `pave` console script. That CLI
# command runs soniq.run_worker(); concurrency is a worker concern, not a
# deploy concern, so tune it here, not in fabfile.
ExecStart=/srv/pave/shared/venv/bin/python -m app.cli worker --concurrency 4

KillMode=mixed
# A deploy restart sends SIGTERM; the worker stops claiming new jobs and lets
# the in-flight one finish before exiting. Bound the drain so a stuck job
# cannot wedge the deploy: systemd escalates to SIGKILL after this.
TimeoutStopSec=60
Restart=always
RestartSec=5

# Hardening (see pave-api.service). The worker writes nothing to disk, but
# shares the same read-only-FS posture; shared stays writable for parity.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/pave/shared

[Install]
WantedBy=multi-user.target
