# systemd unit for the Pave API. Copy to /etc/systemd/system/pave-api.service,
# then `sudo systemctl enable --now pave-api`. fab deploy restarts this after
# flipping the `current` symlink.
#
# Gunicorn is the process manager, Uvicorn the worker class: Gunicorn handles
# graceful reload and worker supervision, Uvicorn runs the ASGI app.

[Unit]
Description=Pave API (Gunicorn + Uvicorn workers)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=deploy
Group=deploy
WorkingDirectory=/srv/pave/current
# Env lives outside the release dirs: every deploy swaps the /srv/pave/current
# symlink, so a release-relative path would vanish. /srv/pave/shared is stable.
EnvironmentFile=/srv/pave/shared/.env.production

# RuntimeDirectory creates and owns /run/pave for the Unix socket nginx
# proxies to. It is recreated on every start, so no stale socket survives.
RuntimeDirectory=pave
RuntimeDirectoryMode=0750

# The venv is shared across releases (fab rebuild-venv recreates it); the code
# is found via WorkingDirectory, which gunicorn puts on sys.path.
ExecStart=/srv/pave/shared/venv/bin/gunicorn app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 3 \
    --bind unix:/run/pave/pave.sock \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile -

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
# A deploy restart sends SIGTERM; gunicorn stops accepting new connections and
# lets in-flight requests finish (up to --graceful-timeout). Give systemd a
# little more than that before it escalates to SIGKILL.
TimeoutStopSec=35
Restart=always
RestartSec=3

# Hardening: the filesystem is read-only except the persistent uploads dir
# (avatars) and the runtime socket dir. The release tree itself is read-only.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/pave/shared

[Install]
WantedBy=multi-user.target
