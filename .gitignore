# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environment
.venv/
venv/

# Environment / secrets
.env
.env.*
!.env.example
!.env.schema

# Local databases
*.db
pave.db
pave.db-journal

# Tailwind standalone binary (downloaded by fab setup-local)
bin/tailwindcss

# Compiled CSS: a build artifact of static/css/source.css. Built by `pave dev`
# locally and by `fab validate` / CI before deploy, then force-included in the
# deploy rsync. Not tracked, so the dev (unminified) and prod (minified) builds
# never drift in git.
static/css/app.css

# User uploads (avatars and anything else the AvatarStorage points at)
static/uploads/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
