DATABASE_URL=required
SECRET_KEY=required
ALLOWED_HOSTS=required
# Falls back to DATABASE_URL when unset, so it is optional, not required.
SONIQ_DATABASE_URL=optional
USE_SQLITE=optional:false
BASE_URL=optional
GOOGLE_CLIENT_ID=optional
GOOGLE_CLIENT_SECRET=optional
GITHUB_CLIENT_ID=optional
GITHUB_CLIENT_SECRET=optional
EMAIL_API_KEY=optional
EMAIL_API_URL=optional
EMAIL_FROM=optional:Pave <noreply@usepave.dev>
SENTRY_DSN=optional
WEBHOOK_SECRET=optional
WEBHOOQ_ENDPOINT=optional
ENABLE_METRICS=optional:false
DEBUG=optional:false
LOG_LEVEL=optional:INFO
AVATAR_DIR=optional:static/uploads/avatars
AVATAR_MAX_BYTES=optional:4194304
